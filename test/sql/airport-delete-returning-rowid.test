# name: test/sql/airport-delete-returning-rowid.test
# description: DELETE ... RETURNING can return the rowid of the deleted rows
# group: [airport]

require httpfs

require airport

# Require test server URL
require-env AIRPORT_TEST_SERVER

statement ok
CREATE SECRET airport_testing (
  type airport,
  auth_token uuid(),
  scope '{AIRPORT_TEST_SERVER}');

statement ok
CALL airport_action('{AIRPORT_TEST_SERVER}', 'reset');

statement ok
CALL airport_action('{AIRPORT_TEST_SERVER}', 'create_database', 'delete_rowid');

statement ok
ATTACH 'delete_rowid' (TYPE AIRPORT, location '{AIRPORT_TEST_SERVER}');

statement ok
CREATE SCHEMA delete_rowid.s;

statement ok
USE delete_rowid.s;

statement ok
CREATE TABLE people (name varchar, age int);

statement ok
INSERT INTO people VALUES ('a', 1), ('b', 2), ('c', 3), ('d', 4);

query IT
SELECT rowid, name FROM people ORDER BY rowid;
----
0	a
1	b
2	c
3	d

query ITI
DELETE FROM people WHERE name = 'b' RETURNING rowid, name, age;
----
1	b	2

# The rowid comes from the rows the server deleted, not from the rowids sent.
query IIT rowsort
DELETE FROM people WHERE age >= 3 RETURNING age, rowid, name;
----
3	2	c
4	3	d

query I
DELETE FROM people WHERE name = 'no such name' RETURNING rowid;
----

query TII
DELETE FROM people RETURNING *, rowid;
----
a	1	0

query I
SELECT count(*) FROM people;
----
0
