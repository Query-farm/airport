# name: test/sql/airport_stub.test
# description: The community build of airport explains how to install the extension from the Query.Farm repository
# group: [airport]

# keep the test independent of repositories and extensions configured in the home directory
statement ok
SET extension_repository_directory='{TEST_DIR}/extension_repositories'

statement ok
SET extension_directory='{TEST_DIR}/extensions'

# no query_farm repository: explain how to add it
statement error
LOAD '{BUILD_DIRECTORY}/extension/airport/airport.duckdb_extension'
----
<REGEX>:.*Query\.Farm extension repository.*CREATE EXTENSION REPOSITORY IF NOT EXISTS query_farm WITH PREFIX 'https://duckdb-extensions\.query\.farm'.*INSTALL airport FROM query_farm.*LOAD airport FROM query_farm.*

# a repository named query_farm that points elsewhere is not used
statement ok
CREATE EXTENSION REPOSITORY query_farm WITH PREFIX 'http://extensions.example.com' USING PUBLIC KEY ''

statement error
LOAD '{BUILD_DIRECTORY}/extension/airport/airport.duckdb_extension'
----
<REGEX>:.*A repository named query_farm is configured with the prefix 'http://extensions\.example\.com', but it is not the Query\.Farm extension repository.*CREATE OR REPLACE EXTENSION REPOSITORY query_farm WITH PREFIX 'https://duckdb-extensions\.query\.farm'.*FORCE INSTALL airport FROM query_farm.*

# the Query.Farm prefix with a key that is not a Query.Farm signing key is not used either
statement ok
CREATE OR REPLACE EXTENSION REPOSITORY query_farm WITH PREFIX 'https://duckdb-extensions.query.farm/' USING PUBLIC KEY ''

statement error
LOAD '{BUILD_DIRECTORY}/extension/airport/airport.duckdb_extension'
----
<REGEX>:.*A repository named query_farm is configured with the prefix 'https://duckdb-extensions\.query\.farm/', but it is not the Query\.Farm extension repository.*

# the real repository, but the extension is not installed from it yet
statement ok
CREATE OR REPLACE EXTENSION REPOSITORY query_farm WITH PREFIX 'https://duckdb-extensions.query.farm' USING PUBLIC KEY ''

statement error
LOAD '{BUILD_DIRECTORY}/extension/airport/airport.duckdb_extension'
----
<REGEX>:.*The query_farm repository is already configured\. Install the extension from it once.*INSTALL airport FROM query_farm.*
